rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStringList(listVal, maxLen) {
      return listVal is list &&
             listVal.size() <= maxLen &&
             (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidSubject(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.examType is string && data.examType in ['ASSIGNMENT', 'INTERNAL', 'SEMESTER'] &&
             data.academicLevel is string && data.academicLevel in ['GRADE_9_10', 'GRADE_11_12', 'UNIVERSITY'] &&
             data.examDateEpochMillis is int && data.examDateEpochMillis > 0 &&
             data.syllabusText is string && data.syllabusText.size() <= 30000 &&
             data.colorIndex is int && data.colorIndex >= 0 && data.colorIndex <= 5 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudyTask(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.subjectId is string && isValidId(data.subjectId) &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 100 &&
             data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 200 &&
             data.focusTip is string && data.focusTip.size() <= 500 &&
             data.scheduledDateIso is string && data.scheduledDateIso.size() == 10 &&
             data.scheduledDateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.difficulty is string && data.difficulty in ['EASY', 'MEDIUM', 'HARD'] &&
             data.estimatedMinutes is int && data.estimatedMinutes >= 5 && data.estimatedMinutes <= 480 &&
             data.completed is bool &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRevisionSheet(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.subjectId is string && isValidId(data.subjectId) &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 10000 &&
             isValidStringList(data.keyPoints, 30) &&
             isValidStringList(data.formulas, 30) &&
             isValidStringList(data.examTips, 20) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPracticeTest(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.subjectId is string && isValidId(data.subjectId) &&
             data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.difficulty is string && data.difficulty in ['STANDARD', 'CHALLENGE'] &&
             data.status is string && data.status in ['IN_PROGRESS', 'GRADED'] &&
             data.totalMarks is int && data.totalMarks >= 1 && data.totalMarks <= 500 &&
             data.earnedMarks is int && data.earnedMarks >= 0 && data.earnedMarks <= data.totalMarks &&
             data.overallFeedback is string && data.overallFeedback.size() <= 4000 &&
             data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 20 &&
             data.questions[0] is map &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      match /subjects/{subjectId} {
        allow get: if isOwner(userId) && isValidId(subjectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'examType', 'academicLevel',
                           'examDateEpochMillis', 'syllabusText', 'colorIndex',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'examType', 'academicLevel',
                           'examDateEpochMillis', 'syllabusText', 'colorIndex',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidSubject(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         isValidSubject(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'examType', 'academicLevel',
                           'examDateEpochMillis', 'syllabusText', 'colorIndex', 'updatedAt'
                         ]);
        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      match /studyTasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         incoming().keys().hasAll([
                           'userId', 'subjectId', 'subjectName', 'topicTitle',
                           'focusTip', 'scheduledDateIso', 'difficulty',
                           'estimatedMinutes', 'completed', 'sortOrder',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'subjectId', 'subjectName', 'topicTitle',
                           'focusTip', 'scheduledDateIso', 'difficulty',
                           'estimatedMinutes', 'completed', 'sortOrder',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidStudyTask(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/subjects/$(incoming().subjectId));
        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidStudyTask(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'topicTitle', 'focusTip', 'scheduledDateIso',
                             'difficulty', 'estimatedMinutes', 'completed', 'updatedAt'
                           ])
                         );
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /revisions/{revisionId} {
        allow get: if isOwner(userId) && isValidId(revisionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(revisionId) &&
                         incoming().keys().hasAll([
                           'userId', 'subjectId', 'subjectName', 'title',
                           'summary', 'keyPoints', 'formulas', 'examTips',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'subjectId', 'subjectName', 'title',
                           'summary', 'keyPoints', 'formulas', 'examTips',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidRevisionSheet(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/subjects/$(incoming().subjectId));
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(revisionId);
      }

      match /practiceTests/{testId} {
        allow get: if isOwner(userId) && isValidId(testId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(testId) &&
                         incoming().keys().hasAll([
                           'userId', 'subjectId', 'subjectName', 'title',
                           'difficulty', 'status', 'totalMarks', 'earnedMarks',
                           'overallFeedback', 'questions', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'subjectId', 'subjectName', 'title',
                           'difficulty', 'status', 'totalMarks', 'earnedMarks',
                           'overallFeedback', 'questions', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().status == 'IN_PROGRESS' &&
                         isValidPracticeTest(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/subjects/$(incoming().subjectId));
        allow update: if isOwner(userId) &&
                         isValidId(testId) &&
                         isValidPracticeTest(incoming(), userId) &&
                         existing().status == 'IN_PROGRESS' &&
                         incoming().userId == existing().userId &&
                         incoming().subjectId == existing().subjectId &&
                         incoming().totalMarks == existing().totalMarks &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (incoming().status == 'IN_PROGRESS' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['questions', 'updatedAt'])) ||
                           (incoming().status == 'GRADED' &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'questions', 'status', 'earnedMarks', 'overallFeedback', 'updatedAt'
                            ]))
                         );
        allow delete: if isOwner(userId) && isValidId(testId);
      }
    }
  }
}
